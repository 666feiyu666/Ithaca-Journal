# 1. 依赖包 (最重要，通常那 1K+ 文件都在这里)
node_modules/
.codex-tmp/

# 2. 本地存档数据 (保护隐私，不要上传你的日记和存档！)
# 根据你的代码，这些文件是存储用户数据的
user_data.json
journal_data.json
library_data.json

# 3. 系统生成文件
.DS_Store
Thumbs.db

# 4. 编辑器配置 (可选，通常不建议上传个人配置)
.vscode/
.idea/

# 5. 构建输出 (如果你以后打包成 exe/dmg)
dist/
.artifacts/
build/
out/
release/
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example
worker-configuration.d.ts

# 6. 日志文件
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 7. 本地派生清单、待重新建立基线的旧场景工具与外部美术源文件
scripts/asset-manifest.local.json
scripts/build-scene-assets.mjs
scripts/scene-assets.config.json
scripts/visual-smoke.mjs
art-source/*

# 8. 研究与设计文档(暂时不上传)
docs/
prototypes/
