# 1. 依赖包 (最重要，通常那 1K+ 文件都在这里)
node_modules/
.codex-tmp/

# 2. 本地存档数据 (保护隐私，不要上传你的日记和存档！)
# 根据你的代码，这些文件是存储用户数据的
user_data.json
journal_data.json
library_data.json

# 3. 系统生成文件
.DS_Store
Thumbs.db

# 4. 编辑器配置 (可选，通常不建议上传个人配置)
.vscode/
.idea/

# 5. 构建输出 (如果你以后打包成 exe/dmg)
dist/
.artifacts/
build/
out/
release/
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example
worker-configuration.d.ts

# 6. 日志文件
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 7. 数据迁移、测试与自动化脚本文件与图片素材
migrations/*
scripts/*
tests/*
art-source/*

# Journey 作者源编译器与定向验证属于正式运行时的一部分
!migrations/0013_story_journeys.sql
!scripts/build-journey-story.mjs
!scripts/lib/
scripts/lib/*
!scripts/lib/twee-parser.mjs
!tests/integration/
tests/integration/*
!tests/integration/worker.spec.ts
!tests/unit/
tests/unit/*
!tests/unit/journey-feature.test.js
!tests/unit/journey-story.test.js

# 8. 研究与设计文档(暂时不上传)
docs/
prototypes/

# 9. 其他不需要上传的文件
AGENTS.md
