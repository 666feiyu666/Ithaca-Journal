{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ithaca-journal",
	"main": "src/server/index.ts",
	"compatibility_date": "2026-08-20",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./src/client",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ithaca-journal-local",
			"migrations_dir": "./migrations"
		}
	],
	"vars": {
		"APP_ENV": "local",
		"AUTH_MODE": "development",
		"TEAM_DOMAIN": "",
		"POLICY_AUD": ""
	},
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.05
		}
	},
	"env": {
		"staging": {
			"name": "ithaca-journal-cloud-staging",
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "ithaca-journal-staging",
					"migrations_dir": "./migrations",
					"database_id": "8a9ac314-3d98-4efd-b263-eb1529887cf9"
				}
			],
			"vars": {
				"APP_ENV": "staging",
				"AUTH_MODE": "access",
				"TEAM_DOMAIN": "https://minerva-ranger-feiyut.cloudflareaccess.com",
				"POLICY_AUD": "4d90f7b9c99235ec27465dbc25d5e1c5068e61737496c95f3fa65b605c6b13e3"
			}
		},
		"production": {
			"name": "ithaca-journal-cloud-production",
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "ithaca-journal-production",
					"migrations_dir": "./migrations"
				}
			],
			"vars": {
				"APP_ENV": "production",
				"AUTH_MODE": "access",
				"TEAM_DOMAIN": "",
				"POLICY_AUD": ""
			}
		}
	}
}
