{
  "name": "ithaca-journal",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "narrative:build": "node scripts/build-journey-story.mjs",
    "dev": "npm run narrative:build && wrangler dev",
    "test": "npm run narrative:build && node --test",
    "test:integration": "npm run narrative:build && vitest run --config tests/vitest.config.ts",
    "types": "wrangler types",
    "check": "npm run narrative:build && npm run types && tsc -p tsconfig.json --noEmit",
    "build": "npm run narrative:build && wrangler deploy --dry-run --env=\"\" --outdir ./dist"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260820.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.124.0"
  },
  "dependencies": {
    "jose": "6.2.9"
  }
}
