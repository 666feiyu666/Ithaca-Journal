{
  "name": "ithaca-journal-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types",
    "check": "npm run types && tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "test": "npm run types && vitest run",
    "build": "wrangler deploy --dry-run --env=\"\" --outdir ./dist",
    "db:migrate:local": "wrangler d1 migrations apply ithaca-journal-local --local",
    "db:migrate:staging": "wrangler d1 migrations apply ithaca-journal-staging --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply ithaca-journal-production --remote --env production",
    "invite": "node ./scripts/create-invite.mjs",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260820.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.124.0"
  }
}
